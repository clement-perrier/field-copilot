# Copier ce fichier en `.env` (à la racine du repo, à côté de docker-compose.yml)
# et renseigner la clé API. Ne jamais committer le `.env` réel.

# Clé API Anthropic — utilisée UNIQUEMENT côté backend (voir CLAUDE.md : jamais
# exposée au frontend, jamais commitée).
ANTHROPIC_API_KEY=

# Renseigné automatiquement par docker-compose.yml pour le service backend.
# Utile de le documenter ici pour lancer le backend hors Docker (ex: pendant le
# développement, avec `uvicorn app.main:app --reload` en local et Postgres en Docker).
DATABASE_URL=postgresql://field_copilot:field_copilot@localhost:5432/field_copilot
